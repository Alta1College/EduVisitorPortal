#
# Extra application settings for docker-compose.prod.yml, copied to app.env (never committed).
# Settings that docker-compose.prod.yml already lists (APP_*, OIDC_*, MAIL_* ...) belong in .env;
# a value here cannot override them. See docs/fork/production-deployment.md.

# Microsoft 365 mail (set MAIL_MAILER=microsoft-graph in .env)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=

# Hosts from Microsoft Entra groups (group IDs are set per site in the admin settings)
ENTRA_HOST_SYNC_ENABLED=false
ENTRA_HOST_SYNC_ROLE=user
ENTRA_HOST_SYNC_CRON="15 * * * *"

# Teams alerts for hosts (docs/fork/teams-notifications.md). Uses the MICROSOFT_GRAPH_* app, which
# also needs the TeamsActivity.Send application permission. TEAMS_APP_ID: a GUID generated once.
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_APP_ID=
# activity (activity-feed alert) or chat (message from the app's bot; needs an Azure Bot resource).
# The bot uses the app registration above unless TEAMS_BOT_APP_ID/SECRET/TENANT_ID are set.
TEAMS_DELIVERY=activity
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_SECRET=
# TEAMS_BOT_TENANT_ID=
# TEAMS_BOT_SERVICE_URL=https://smba.trafficmanager.net/teams/
TEAMS_BOT_INCLUDE_PHOTO=false

# Staff sign-in with Microsoft Entra ID: also accept its xms_edov claim as a verified email
OIDC_EMAIL_VERIFIED_CLAIMS=email_verified

# Visitor experience defaults (each can be changed in the admin settings)
VISITOR_AUTO_SIGN_OUT_TIME=18:00

# Emergency SMS and e-mail to everyone signed in when a roll call starts (docs/fork/emergency-broadcast.md).
# SMS uses Edgility MessagePort: API key (Access Token + Token ID) and an approved sender ID. Delivery
# receipts: MessagePort Settings > Webhooks, event message_dlr, POST JSON to https://<host>/webhooks/messageport.
EMERGENCY_SMS_ENABLED=false
EMERGENCY_EMAIL_ENABLED=false
MESSAGEPORT_ACCESS_TOKEN=
MESSAGEPORT_TOKEN_ID=
MESSAGEPORT_SENDER_ID=
MESSAGEPORT_WEBHOOK_SECRET=
# MESSAGEPORT_BASE_URL=https://app.messageport.com.au/api
# true: validate only (/v2/sms/dry), nothing is sent
MESSAGEPORT_DRY_RUN=false
