APP_NAME="Edu Visitor Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=6
AUTH_PASSWORD_RESET_DECAY_SECONDS=60

# Authentication mode:
# local = local login only
# local_and_sso = local login and SSO login
# sso_only = SSO for normal users, local login only for break-glass accounts
AUTH_MODE=local

SSO_ENABLED=false
SSO_DRIVER=oidc

OIDC_DISPLAY_NAME="Company SSO"
# Fork: example address shown in the login e-mail field.
LOGIN_EMAIL_PLACEHOLDER=max.mustermann@example.com
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/oidc/callback"
OIDC_SCOPES="openid profile email"
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Claims that mark the email as verified. Microsoft Entra ID: email_verified,xms_edov (add the xms_edov optional claim).
OIDC_EMAIL_VERIFIED_CLAIMS=email_verified
OIDC_ALLOWED_DOMAINS=
OIDC_PROVISIONING_MODE=disabled
OIDC_SYNC_USER_PROFILE=true
OIDC_STORE_CLAIMS=false
OIDC_SYNC_ROLES=false
OIDC_SYNC_ROLES_ON_LOGIN=false
OIDC_SYNC_ROLES_REMOVE_UNMAPPED=false
OIDC_GROUPS_CLAIM=groups
OIDC_LOGOUT_MODE=local
OIDC_CLOCK_TOLERANCE=60
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OIDC_AUTO_PROVISION_DEFAULT_ROLE=user
OIDC_AUTO_PROVISION_DEFAULT_DEPARTMENT_ID=

MFA_ENABLED=true
MFA_OPTIONAL_FOR_USERS=true
APP_MFA_REQUIRED_ROLES=admin,super_admin
APP_MFA_REQUIRED_FOR_AUTH_METHODS=local
# Requires an App-MFA-confirmed session for /admin; it does not prompt again if App-MFA was already confirmed in this session.
# For SSO admins, this triggers a local VisitorPortal App-MFA challenge only when the current SSO session has not passed App-MFA yet.
APP_MFA_REQUIRED_FOR_ADMIN_PANEL_AUTH_METHODS=local,sso
APP_MFA_SESSION_TTL_MINUTES=720

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=visitorportal
DB_USERNAME=visitor
DB_PASSWORD=visitor_pw

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

HEALTH_CACHE_STORE=database
HEALTH_QUEUE_STALE_AFTER=300
HEALTH_SCHEDULER_STALE_AFTER=300
HEALTH_HEARTBEAT_TTL=600

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sign visitors out automatically at this time (site timezone, HH:MM); sites can override or set "off".
VISITOR_AUTO_SIGN_OUT_TIME=18:00

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=visitorportal@example.test
MAIL_FROM_NAME="VisitorPortal"

# Microsoft 365 without a mailbox password: set MAIL_MAILER=microsoft-graph and an Entra app
# registration with the Mail.Send application permission, scoped to the sending mailbox.
# See docs/fork/microsoft-graph-mail.md.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=

# Optional: hosts from Microsoft Entra groups (docs/fork/phase-10-entra-hosts-and-deployment.md).
# Uses the MICROSOFT_GRAPH_* app unless the ENTRA_HOST_SYNC_* credentials are set. Group IDs are
# set per site in the admin settings ("Entra host groups"); ENTRA_HOST_GROUP_IDS is the default.
ENTRA_HOST_SYNC_ENABLED=false
ENTRA_HOST_GROUP_IDS=
ENTRA_HOST_SYNC_ROLE=user
ENTRA_HOST_SYNC_CRON="15 * * * *"

# Optional: Microsoft Teams activity-feed alerts for hosts (docs/fork/teams-notifications.md).
# Uses the MICROSOFT_GRAPH_* app (plus the TeamsActivity.Send application permission) unless the
# TEAMS_* credentials are set. TEAMS_APP_ID is a GUID you generate once for the Teams app package
# (php artisan visitorportal:teams:package). Whether hosts get e-mail and/or Teams by default is an
# admin setting ("Notifications"); each host can change it in their profile.
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_APP_ID=
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_TIMEOUT=15
# How hosts get the Teams notification: activity (alert in the activity feed, default) or chat
# (1:1 message with an Adaptive Card from the app's bot; needs an Azure Bot resource). The bot
# defaults to the TEAMS_*/MICROSOFT_GRAPH_* app registration and tenant.
TEAMS_DELIVERY=activity
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_SECRET=
# TEAMS_BOT_TENANT_ID=
# TEAMS_BOT_SERVICE_URL=https://smba.trafficmanager.net/teams/
# Show the visitor's sign-in photo in the chat message (short-lived signed link). Default false.
# TEAMS_BOT_INCLUDE_PHOTO=false

# Visitor contact fields are optional by default. Supported values: optional, require_one, require_email, require_phone.
VISITOR_CONTACT_REQUIREMENT=optional

# Reception operation windows.
# Hours ahead from now for the Check-In/Out board. Planned visits starting within this window and not yet ended can be checked in.
RECEPTION_CHECK_IN_WINDOW_HOURS=48
# Hours ahead from now for the reception dashboard badge-preparation count. Counts unprinted badges for planned visits in this window.
RECEPTION_BADGE_PREPARATION_WINDOW_HOURS=48

# Privacy retention defaults.
PRIVACY_VISIT_RETENTION_DAYS=365
PRIVACY_PURGE_ENABLED=true
PRIVACY_PURGE_CHUNK_SIZE=500
PRIVACY_NOTIFICATION_RETENTION_DAYS=365
PRIVACY_SEARCH_RATE_LIMIT_PER_MINUTE=60
PRIVACY_WALK_IN_CONFIDENTIAL_DEFAULT=true
# Optional operator-owned privacy notice URL. External guest mails include this link when set.
PRIVACY_NOTICE_URL=
DATA_RETENTION_RUN_LOG_DAYS=1095
PRIVACY_TECHNICAL_RETENTION_ENABLED=true
PRIVACY_SESSION_RETENTION_DAYS=30
PRIVACY_FAILED_JOB_RETENTION_DAYS=30
PRIVACY_JOB_BATCH_RETENTION_DAYS=30
PRIVACY_LOG_RETENTION_DAYS=30
PRIVACY_HEALTH_CACHE_RETENTION_DAYS=7

# White-label branding. Override these paths with files inside backend/public.
BRANDING_NAME="Edu Visitor Portal"
BRANDING_LOGO_LIGHT="images/branding/logo-with-text-light.svg"
BRANDING_LOGO_DARK="images/branding/logo-with-text-dark.svg"
BRANDING_MAIL_LOGO="images/branding/logo-with-text-light.svg"
BRANDING_BADGE_LOGO="images/branding/logo-with-text-light.svg"
BRANDING_BADGE_DESIGN="standard"
BRANDING_BADGE_ACCENT_COLOR="#ff8a00"
BRANDING_MONITOR_FALLBACK_HEADING="Welcome to Edu Visitor Portal"
BRANDING_MONITOR_FALLBACK_SUBHEADING="We're glad you're here."
BRANDING_MONITOR_SLIDE_HEADING="Welcome!"
# Disabled by default for privacy. Enable only if visitor monitor slides are intentionally used.
BRANDING_MONITOR_AUTO_GENERATION=false
BRANDING_MONITOR_DISPLAY_MODE=title_first_initial_last_name

VISITORPORTAL_EASTER_EGG=false
VISITORPORTAL_EASTER_EGG_PRODUCTION=false

# Branding and monitor image upload guardrails. 20 MB remains intentionally allowed for large displays.
UPLOAD_IMAGE_MAX_SIZE_KB=20480
UPLOAD_IMAGE_MAX_WIDTH=20000
UPLOAD_IMAGE_MAX_HEIGHT=20000
UPLOAD_IMAGE_MAX_PIXELS=150000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# For PDF Badge (Gotenberg in Docker):
GOTENBERG_URL=http://gotenberg:3000

#GitHub Link
GITHUB_REPO_URL="https://github.com/Alta1College/EduVisitorPortal"

# Fork: show departments (upstream grouping for the "manager" role). Off by default.
DEPARTMENTS_ENABLED=false

# Fork: emergency messages to visitors when a roll call starts (docs/fork/emergency-broadcast.md).
EMERGENCY_SMS_ENABLED=false
EMERGENCY_EMAIL_ENABLED=false
# Edgility MessagePort SMS API: API key (Access Token + Token ID), approved sender ID, webhook secret.
MESSAGEPORT_ACCESS_TOKEN=
MESSAGEPORT_TOKEN_ID=
MESSAGEPORT_SENDER_ID=
MESSAGEPORT_WEBHOOK_SECRET=
MESSAGEPORT_BASE_URL=https://app.messageport.com.au/api
# true: validate only (/v2/sms/dry), nothing is sent
MESSAGEPORT_DRY_RUN=false
